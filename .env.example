# Server Port for local testing (Vercel automatically handles this in production)
PORT=3001
NODE_ENV=development

# Supabase PostgreSQL Connection String
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# 💡 IMPORTANT FOR VERCEL (SERVERLESS):
# Use the "Connection Pooler" (Transaction mode, port 6543) connection string.
# Serverless functions scale dynamically, and Supabase's Transaction Pooler prevents connection exhaustion!
#
# Format:
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
